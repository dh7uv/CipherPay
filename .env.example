# Application
APP_NAME=CryptaGuard
DEBUG=true
API_V1_STR=/api/v1

# Optional infrastructure (the application falls back to in-memory storage for local demos)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=cryptaguard_db
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
RATE_LIMIT_PER_MINUTE=60
SUSPICIOUS_DEVICE_IDS=
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Set these in your deployment environment. Omit locally only for ephemeral demo keys.
# SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# `openssl rand -base64 32` produces a valid AES-256-GCM key.
# ENCRYPTION_KEY=
# HMAC_SECRET_KEY=
